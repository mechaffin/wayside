---
/**
 * The shell for a printable sheet, US Letter portrait.
 *
 * Standalone rather than built on WaysideLayout: a sheet wants no site chrome,
 * no analytics, and no screen typography. Both print routes share this so the
 * card that holds one code and the sheet that holds eight cannot drift into
 * printing at different sizes.
 */
interface Props {
  title: string;
  /** Sheet heading. */
  heading: string;
  /** One line under the heading, telling a reader at the venue what to do. */
  sub?: string;
}

const { title, heading, sub } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      @page {
        size: letter portrait;
        margin: 0.5in;
      }
      /* Codes need dark modules on a light field on paper as much as on a
         screen, so nothing here follows a colour scheme. */
      html { color-scheme: light; }
      body {
        margin: 0;
        background: #fff;
        color: #000;
        font: 12pt/1.35 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      .sheet {
        width: 7.5in;
        margin: 0 auto;
        padding: 0.25in 0;
      }
      .sheet h1 { font-size: 16pt; margin: 0 0 0.05in; }
      .sheet .sub { font-size: 10pt; margin: 0 0 0.25in; color: #333; }
      .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.3in;
      }
      /* One code gets the full width, because a lone card floating in a
         half-page column reads as a printing mistake. */
      .grid.single { grid-template-columns: 1fr; }
      .card {
        border: 1pt solid #000;
        padding: 0.18in;
        text-align: center;
        break-inside: avoid;
      }
      .card h2 { font-size: 13pt; margin: 0 0 0.08in; }
      .card p { margin: 0; }
      .card .label { font-size: 10.5pt; margin-bottom: 0.12in; }
      /* 1.5in minimum. Below that a phone camera cannot focus close enough in
         poor light to read the code off paper in a sheet protector. */
      .card img { width: 1.9in; height: 1.9in; display: block; margin: 0 auto 0.1in; }
      .grid.single .card img { width: 3.2in; height: 3.2in; }
      .card .url {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 8.5pt;
        word-break: break-all;
      }
      .note { font-size: 9pt; color: #444; margin-top: 0.3in; }
      @media screen {
        body { padding: 1rem; }
        .screen-note { font: 14px/1.4 sans-serif; background: #fdf3d8; padding: 0.75rem; margin-bottom: 1rem; }
      }
      @media print {
        .screen-note { display: none; }
      }
    </style>
  </head>
  <body>
    <p class="screen-note">
      Print this at 100% scale, US Letter, portrait, background graphics on. Then
      scan every code off the paper before you tape it down.
    </p>
    <div class="sheet">
      <h1>{heading}</h1>
      {sub && <p class="sub">{sub}</p>}
      <slot />
    </div>
  </body>
</html>
