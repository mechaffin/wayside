---
import WaysideLayout from '../layouts/WaysideLayout.astro';
import { link, allCollections, membersOf } from '../lib/resolve';

const collections = await allCollections();
const withCounts = await Promise.all(
  collections.map(async (c) => ({
    entry: c,
    live: (await membersOf(c)).filter((m) => m.data.status === 'live').length,
  })),
);
const topics = withCounts.filter((c) => c.entry.data.kind === 'topic');
const events = withCounts.filter((c) => c.entry.data.kind === 'event');
---

<WaysideLayout
  title="Waysides"
  description="Quick, phone-readable guides to what happens at an event, behind printed codes at the venue."
  path="/"
>
  <h1>Waysides</h1>
  <p>
    Quick guides to what happens at an event: when things start, who to ask,
    what the unfamiliar words mean. These are the things everyone at the
    venue already knows and nobody writes down.
  </p>
  <p>
    A wayside is the low sign beside a trail that tells you what you are looking
    at, without sending you to find a ranger first. These work the same way.
    Scan a posted code, get one question answered, put your phone back in your
    pocket.
  </p>

  <h2>Topics</h2>
  <ul class="memberships">
    {topics.map(({ entry, live }) => (
      <li>
        <a href={link(`/c/${entry.id}`)}>{entry.data.title} ({live})</a>
      </li>
    ))}
  </ul>

  {
    events.length > 0 && (
      <>
        <h2>Events</h2>
        <ul class="memberships">
          {events.map(({ entry, live }) => (
            <li>
              <a href={link(`/c/${entry.id}`)}>{entry.data.title} ({live})</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</WaysideLayout>
